{define title}{if $activeCategory}{$activeCategory->name}{else}Knihy{/if}{/define}

{block content}
<div class="book-list-header">
    <h1>{if $activeCategory}{$activeCategory->name}{else}Všechny knihy{/if}</h1>

    <button n:if="!$categoryNotFound && count($books)" type="button" class="btn-secondary btn-print js__print"><i class="bi bi-printer"></i> Vytisknout seznam</button>
</div>

{if $categoryNotFound}
    <p>Kategorie nebyla nalezena.</p>
{elseif !count($books)}
    <p>V této kategorii zatím nejsou žádné knihy.</p>
{else}
<div class="book-toolbar">
    <div class="book-search">
        <i class="bi bi-search"></i>
        <input type="search" id="bookSearch" placeholder="Hledat podle názvu nebo autora…" aria-label="Hledat knihy">
    </div>
    <p class="book-count">Zobrazeno <strong id="bookCount">{count($books)}</strong> knih</p>
</div>

<div class="print-only print-meta">
    <span>Seznam knih<span id="printQuery" hidden> · Hledání: „<span></span>“</span></span>
    <span class="print-meta__right">
        <span>Počet knih: <strong id="printCount">{count($books)}</strong></span>
        <span>Vytištěno: {=date('j. n. Y')}</span>
    </span>
</div>

<div class="book-grid">
    {foreach $books as $book}
    {var $bookAuthors = $book->related('authors')->order('sort_order, id')}
    <a n:href="Home:detail $book->slug" class="book-card" data-authors="{foreach $bookAuthors as $author}{$author->name}{sep}, {/sep}{/foreach}">
        <div class="book-card__cover">
            {if $book->image_url}
                <img src="{$basePath}/assets/images/books/{$book->image_url}" alt="Obálka knihy {$book->title}" loading="lazy">
            {else}
                <i class="bi bi-book"></i>
            {/if}
            {if $book->category}
            <span class="book-card__badge">{$book->category->name}</span>
            {/if}
        </div>
        <div class="book-card__body">
            <h2 class="book-card__title">{$book->short_name ?? $book->title}</h2>
            <p class="book-card__author">{foreach $bookAuthors as $author}{$author->name}{breakIf true}{/foreach}{if count($bookAuthors) > 1} et al.{/if}</p>
            <div class="book-card__footer">
                {if $book->rating !== null}
                <span><i class="bi bi-star-fill book-card__rating-icon"></i> {$book->rating|number:1} ({$book->ratings_count})</span>
                {/if}
                <span>{$book->published_year}</span>
            </div>
        </div>
    </a>
    {/foreach}
</div>
<p id="bookEmptyState" class="book-empty" hidden>Žádná kniha neodpovídá hledání.</p>

<table class="print-only print-table">
    <thead>
        <tr>
            <th>Název</th>
            <th>Autoři</th>
            <th>Rok vydání</th>
            <th>Kategorie</th>
            <th>ISBN</th>
            <th>Hodnocení</th>
        </tr>
    </thead>
    <tbody>
        <tr n:foreach="$books as $book">
            <td>{$book->title}</td>
            <td>{foreach $book->related('authors')->order('sort_order, id') as $author}{$author->name}{sep}, {/sep}{/foreach}</td>
            <td>{$book->published_year}</td>
            <td>{$book->category?->name}</td>
            <td class="print-table__nowrap">{$book->isbn ?? '–'}</td>
            <td class="print-table__nowrap">{if $book->rating !== null}{$book->rating|number:1} ({$book->ratings_count}){else}–{/if}</td>
        </tr>
    </tbody>
</table>
{/if}
{/block}
