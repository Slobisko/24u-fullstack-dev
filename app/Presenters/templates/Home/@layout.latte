<!doctype html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{ifset title}{include title|stripHtml}{else}Evidence knih{/ifset}</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	<link rel="stylesheet" href="{$basePath}/assets/css/style.css">
	<script defer src="{$basePath}/assets/js/app.js"></script>
</head>
<body>
	<div id="flashMessages" class="flash-container" aria-live="polite"></div>

	<div class="page-shell">
		<aside>
			{include sideMenu.latte}
		</aside>
		<main class="page-content">
			{include content}
		</main>
	</div>
</body>
</html>
